# =============================================================================
# WAVE PARSER - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust the values.
# IMPORTANT: .env is gitignored - never commit real secrets!
#
# Usage:
#   Local/Docker: All sections below
#   Render+Netlify: See DEPLOYMENT_RENDER_NETLIFY.md
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (Spring Boot) - REQUIRED for all deployments
# -----------------------------------------------------------------------------

# JWT Secret - MUST be base64-encoded, at least 32 bytes when decoded
# Generate a secure key with: openssl rand -base64 48
# This is REQUIRED - the app will not start without it
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2UtaW4tcHJvZCE=

# JWT token expiration (milliseconds) - 1 hour default
JWT_EXPIRATION_MS=3600000

# Frontend URL(s) for CORS (comma-separated list)
# In production on Render+Netlify, set this to your Netlify app URL:
#   ALLOWED_ORIGINS=https://your-app.netlify.app
# For local development, include localhost:
ALLOWED_ORIGINS=http://localhost:5173,https://*.netlify.app

# File upload limits
MAX_FILE_SIZE=100MB

# Storage configuration
# Docker: /data (shared volume with worker)
# Render: /tmp (ephemeral filesystem)
# Local: any writable directory
APP_STORAGE_DIR=/data
APP_STORAGE_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL) - REQUIRED for Render deployment
# -----------------------------------------------------------------------------
# Local/Docker: Uses docker-compose postgres service
# Render: Use Render's managed PostgreSQL service
# For Render/Production - override these with your Render PostgreSQL credentials:
# SPRING_DATASOURCE_URL=postgresql://user:pass@host:5432/honeycomb
# SPRING_DATASOURCE_USERNAME=praful
# SPRING_DATASOURCE_PASSWORD=your-password

# For Docker/Local (uses docker-compose postgres):
POSTGRES_USER=praful
POSTGRES_PASSWORD=change-me

# -----------------------------------------------------------------------------
# RABBITMQ - REQUIRED for async transcription processing
# -----------------------------------------------------------------------------
# Local/Docker: Uses docker-compose rabbitmq service
# Render: Use CloudAMQP free tier (https://cloudamqp.com)
# For Render/Production with CloudAMQP - set these:
# SPRING_RABBITMQ_HOST=your-cloudamqp-host
# SPRING_RABBITMQ_PORT=5672
# SPRING_RABBITMQ_USERNAME=your-cloudamqp-user
# SPRING_RABBITMQ_PASSWORD=your-cloudamqp-password

# For Docker/Local:
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# -----------------------------------------------------------------------------
# WORKER (Python Whisper) - Only needed if running whisper worker
# -----------------------------------------------------------------------------
# Model size: tiny | base | small | medium
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=true
WHISPER_TRANSLATE=false
CHUNK_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# TRANSCRIPTION MODE - see DEMO_CHANGES.md
# -----------------------------------------------------------------------------
# queue      : original async flow (RabbitMQ + Python worker) [default]
# whispercpp : synchronous, embedded whisper.cpp binary baked into the backend
# api        : synchronous, hosted OpenAI-compatible API (e.g. Groq free tier)
# TRANSCRIPTION_MODE=queue
# TRANSCRIPTION_FALLBACK_TO_API=true
# GROQ_API_KEY=
# APP_WHISPER_BINARY=/opt/whisper/whisper-cli
# APP_WHISPER_MODEL=/opt/models/ggml-tiny-q5_1.bin
# APP_WHISPER_THREADS=1

# -----------------------------------------------------------------------------
# CHUNKING CONFIGURATION
# -----------------------------------------------------------------------------
APP_CHUNK_TARGET_SECONDS=600
APP_CHUNK_SILENCE_NOISE_DB=-35
APP_CHUNK_SILENCE_MIN_DURATION=0.5
APP_CHUNK_OVERLAP_SECONDS=1.0

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
APP_RATE_LIMIT_UPLOADS_PER_MINUTE=10
APP_RATE_LIMIT_MAX_ACTIVE_JOBS=3

# -----------------------------------------------------------------------------
# JOB TIMEOUT
# -----------------------------------------------------------------------------
APP_JOB_TIMEOUT_MINUTES=30
APP_JOB_WATCHDOG_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# CLEANUP SCHEDULER
# -----------------------------------------------------------------------------
APP_CLEANUP_CRON=0 0 3 * * *
