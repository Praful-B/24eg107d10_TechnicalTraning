# Wave Parser Environment Configuration
# Copy this file to .env and adjust the values.
# IMPORTANT: .env is gitignored - never commit real secrets!

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_USER=praful
POSTGRES_PASSWORD=change-me  # CHANGE THIS in production!

# =============================================================================
# MESSAGE BROKER (RabbitMQ)
# =============================================================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest  # CHANGE THIS in production!

# =============================================================================
# BACKEND (Spring Boot)
# =============================================================================
# JWT Secret - MUST be base64-encoded, at least 32 bytes when decoded
# Generate a secure key with: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2UtaW4tcHJvZCE=

# JWT token expiration (milliseconds) - 1 hour default
JWT_EXPIRATION_MS=3600000

# Storage configuration
APP_STORAGE_DIR=/data  # In Docker, this is a shared volume
APP_STORAGE_RETENTION_DAYS=7  # Delete files older than this

# File upload limits
MAX_FILE_SIZE=100MB

# Frontend URL for CORS (comma-separated list)
# In production, set this to your Netlify app URL
# Example: ALLOWED_ORIGINS=https://your-app.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,https://*.netlify.app

# =============================================================================
# WORKER (Python Whisper)
# =============================================================================
# Model size: tiny | base | small | medium
# Larger = better quality but slower and more memory
WHISPER_MODEL_SIZE=base

# Compute device: cpu | cuda (GPU)
WHISPER_DEVICE=cpu

# Compute type: int8 | float32 | float16
# int8 is fastest on CPU, float16 needs GPU
WHISPER_COMPUTE_TYPE=int8

# Voice Activity Detection - filters out silence
WHISPER_VAD_FILTER=true

# Translate non-English audio to English
WHISPER_TRANSLATE=false

# Maximum retry attempts for failed chunks
CHUNK_MAX_ATTEMPTS=3

# =============================================================================
# CHUNKING CONFIGURATION
# =============================================================================
# Target chunk length in seconds (longer = fewer chunks, faster processing)
APP_CHUNK_TARGET_SECONDS=600

# Silence detection threshold in dB
APP_CHUNK_SILENCE_NOISE_DB=-35

# Minimum silence duration to consider for splitting (seconds)
APP_CHUNK_SILENCE_MIN_DURATION=0.5

# Overlap between chunks to avoid cutting words (seconds)
APP_CHUNK_OVERLAP_SECONDS=1.0

# =============================================================================
# RATE LIMITING
# =============================================================================
# Maximum uploads per minute per user
APP_RATE_LIMIT_UPLOADS_PER_MINUTE=10

# Maximum concurrent jobs per user
APP_RATE_LIMIT_MAX_ACTIVE_JOBS=3

# =============================================================================
# JOB TIMEOUT
# =============================================================================
# Jobs stuck in PROCESSING longer than this are marked FAILED (minutes)
APP_JOB_TIMEOUT_MINUTES=30

# Watchdog check interval (milliseconds)
APP_JOB_WATCHDOG_INTERVAL_MS=60000

# =============================================================================
# CLEANUP SCHEDULER
# =============================================================================
# Cron expression for daily cleanup (3 AM by default)
APP_CLEANUP_CRON=0 0 3 * * *
